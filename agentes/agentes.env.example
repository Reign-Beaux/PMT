# Copia este archivo a .agentes.env en la raíz del proyecto gestionado.
# Sin secretos: los tokens viven en ~/.config/pmt/tokens/ y aquí va solo el nombre del archivo.
# Ese nombre debe ser también el del agente en PMT.
# La cadena de base de datos sí queda aquí: añade .agentes.env y .agentes/ al .gitignore del proyecto.

# Proyecto
PROYECTO_RUTA=/ruta/absoluta/al/proyecto
PROYECTO_DESCRIPCION="Tiene backend/ (Go) y frontend/ (React, Vite, TypeScript)."

# Base de datos
DB_URL=postgres://usuario:clave@localhost:5432/base?sslmode=disable
DB_CONTENEDOR=postgresql

# Puertos
PUERTO_BACKEND=8090
PUERTO_FRONTEND=5173

# Servidor MCP de PMT
PMT_URL=http://127.0.0.1:8080/mcp

# herdr: etiqueta o ID del workspace; si la etiqueta no existe, se crea.
HERDR_WORKSPACE=mi-proyecto
# Prefijo de los nombres en herdr, que no se repiten entre workspaces. Vacío si solo hay un equipo vivo.
HERDR_PREFIJO=

# Dónde guardar panes y perfiles generados. Por defecto, $PROYECTO_RUTA/.agentes.
#AGENTES_DIR=

# Por agente: herramienta (claude, codex o mcode), modelo, effort (medium o high) y archivo de token.
# El effort de mcode es global, en defaultModelThinking de ~/.minimax/config.yaml: iniciar.sh avisa si difiere.
PP_HERRAMIENTA=claude;  PP_MODELO=opus;  PP_EFFORT=medium;  PP_TOKEN=mi-proyecto-pp
DP_HERRAMIENTA=claude;  DP_MODELO=opus;  DP_EFFORT=medium;  DP_TOKEN=mi-proyecto-dp
TL_HERRAMIENTA=claude;  TL_MODELO=opus;  TL_EFFORT=medium;  TL_TOKEN=mi-proyecto-tl
CR_HERRAMIENTA=claude;  CR_MODELO=opus;  CR_EFFORT=medium;  CR_TOKEN=mi-proyecto-cr

M=minimax/MiniMax-M3.1-Flash
PC_HERRAMIENTA=mcode;        PC_MODELO=$M;        PC_EFFORT=high;        PC_TOKEN=mi-proyecto-pc
DEVBACK_HERRAMIENTA=mcode;   DEVBACK_MODELO=$M;   DEVBACK_EFFORT=high;   DEVBACK_TOKEN=mi-proyecto-devback
DEVFRONT_HERRAMIENTA=mcode;  DEVFRONT_MODELO=$M;  DEVFRONT_EFFORT=high;  DEVFRONT_TOKEN=mi-proyecto-devfront
QAP_HERRAMIENTA=mcode;       QAP_MODELO=$M;       QAP_EFFORT=high;       QAP_TOKEN=mi-proyecto-qap
QA_HERRAMIENTA=mcode;        QA_MODELO=$M;        QA_EFFORT=high;        QA_TOKEN=mi-proyecto-qa
