              },
              "id": {
                "type": "string"
              },
              "stage_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              }
            },
