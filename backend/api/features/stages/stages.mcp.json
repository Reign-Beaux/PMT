      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "description": "UUID de la etapa",
          "type": "string"
        },
        "status": {
          "description": "Nuevo status: planning, stand_by, in_dev, done, stopped o cancelled",
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "status"
      ],
      "type": "object"
    },
