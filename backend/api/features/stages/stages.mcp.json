          "type": "string"
        },
        "project_id": {
          "description": "UUID del proyecto al que pertenece la etapa",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "name",
        "description"
      ],
      "type": "object"
    },
    "outputSchema": {
