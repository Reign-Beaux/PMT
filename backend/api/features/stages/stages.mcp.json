        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "type": "integer"
        },
        "project_id": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "name",
        "description",
        "position",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    }
