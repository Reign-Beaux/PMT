[
  {
    "description": "Crea un plan de desarrollo, versión 1. Solo DP. Pertenece a una etapa, con stage_id y al menos una tarea de ella sin repetir y sin retirar, o a un bug, con bug_id y sin tareas: exactamente uno de los dos. Todos los campos de contenido son obligatorios; si uno no aplica, se escribe el motivo. No tiene status ni aprobación y no frena transiciones. Usa list_stages, list_tasks y list_bugs para obtener los ID.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "description": "Cada criterio con la tarea a la que pertenece, quién lo comprueba y cómo: Dev con pruebas unitarias, build y lint; QA en pantalla, contra la API real solo si la tarea la consume, y en los datos guardados",
          "type": "string"
        },
        "bug_id": {
          "description": "UUID del bug. Excluye stage_id y task_ids",
          "type": "string"
        },
        "edge_cases": {
          "description": "Valores extremos, caracteres especiales y datos corruptos",
          "type": "string"
        },
        "error_handling": {
          "description": "Qué falla con mensaje, nunca en silencio",
          "type": "string"
        },
        "scope": {
          "description": "Archivos a crear o tocar y lo que queda fuera",
          "type": "string"
        },
        "screen_states": {
          "description": "Estados de pantalla: carga, vacío, error y móvil. Si no aplica, escribe el motivo",
          "type": "string"
        },
        "stage_id": {
          "description": "UUID de la etapa. Exige task_ids; excluye bug_id",
          "type": "string"
        },
        "task_ids": {
          "description": "UUID de las tareas de la etapa que cubre el plan",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "technical_decisions": {
          "description": "Estructura, contrato y bibliotecas",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "technical_decisions",
        "screen_states",
        "edge_cases",
        "error_handling",
        "acceptance_criteria"
      ],
      "type": "object"
    },
    "name": "create_dev_plan",
    "outputSchema": {
      "additionalProperties": false,
