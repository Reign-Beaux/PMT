          "description": "UUID de la tarea o el bug. Va con item_kind, sin stage_id",
          "type": "string"
        },
        "item_kind": {
          "description": "Tipo de elemento: task o bug. Va con item_id, sin stage_id",
          "type": "string"
        },
        "pending": {
          "description": "Solo los abiertos, bloqueantes primero",
          "type": "boolean"
        },
        "stage_id": {
          "description": "UUID de la etapa: lista los hallazgos de sus tareas, incluidas las retiradas. Va sin item_kind ni item_id",
          "type": "string"
        }
